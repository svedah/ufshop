@page "/adm"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

<PageTitle>Administrera</PageTitle>

@* <h1>You are authenticated</h1> *@

<AuthorizeView Roles="Administrator">

    <h1 class="text-center my-4">Hantera Shoppar</h1>
    
    <Tabs class="nav-fill flex-column flex-md-row fw-bold">
        <Tab Title="Beställningar">
            <Content>
                <AdministrationShopOrders />
            </Content>
        </Tab>
        <Tab Title="Skapa ny shop">
            <Content>
                <AdministrationCreateShop />
            </Content>
        </Tab>
        <Tab Title="Shoptoggling">
            <Content>
                <AdministrationShopToggler />
            </Content>
        </Tab>
        <Tab Title="Användare">
            <Content>
                <AdministrationUsers />
            </Content>
        </Tab>
    </Tabs>

</AuthorizeView>
