    private ShopOrderStatus Status { get; set; }
    private bool ShowIframe { get; set; }
    private Random Random = new Random();//delete
    private int RandomNumber { get; set; }//delete
    private CancellationTokenSource cts;
    private readonly BeService BeService;
    private readonly PaymentService Service;

    private string SwishRedirectUrl;

