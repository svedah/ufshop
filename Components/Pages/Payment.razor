@page "/payment/{id:guid}"
@using Microsoft.EntityFrameworkCore
@using ufshop.Components.Account
@using ufshop.Data
@using ufshop.Data.Models
@using ufshop.Helpers
@using ufshop.Services
@using ufshop.Shared
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime;

@implements IDisposable

@code {
    [Parameter]
    public Guid id { get; set; } //order id
    private ShopOrder Order { get; set; }
    private bool ShowIframe { get; set; }

    private CancellationTokenSource cts;
    private bool _disposed = false;
    private Random random = new Random();
    private readonly BeService BeService;
    private readonly PaymentService Service;

    //för qr-kod
    private string SwishRedirectUrl = string.Empty;
    private string QrEmbeddedImage = string.Empty;

    //för knapp
    private string SwishDirectUrl = string.Empty;
    private string OrderConfirmationUrl = string.Empty;
    private string TheScript
    {
        get
        {
            return "<script>function open2links(){window.location.href=\"" + @OrderConfirmationUrl + "\";window.open(\"" + @SwishDirectUrl + "\", \"_blank\");}</script>";
        }
    }

    public Payment(BeService beService)
    {
        BeService = beService;
        Service = new PaymentService(beService);
        cts = new CancellationTokenSource();
        ShowIframe = false;
    }

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;

        //för qr-kod
        SwishRedirectUrl = Service.BuildSwishRedirectUrl(id);
        QrEmbeddedImage = QrImageHelper.MakeEmbeddedImage(SwishRedirectUrl);

        //för knapp
        SwishDirectUrl = Service.BuildSwishDirectUrl(id);
        OrderConfirmationUrl = Service.BuildOrderConfirmationUrl(id);

        UpdateOrder();
        if (Order is not null)
        {
            _ = RunLoopAsync(cts.Token);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        cts.Cancel();
    }

    private async Task RunLoopAsync(CancellationToken token)
    {
        //kolla var 3:e sekund om ordern bytt status från unpaid
        //när orderstatus bytt till inte unpaid (swishtriggered)
        //länkas sidan automatiskt vidare till orderconfirmation/guid
        PeriodicTimer timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                using IServiceScope scope = Services.CreateScope();
                ApplicationDbContext db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

                ShopOrder so = await db.ShopOrders.Where(e => e.Id.Equals(id)).FirstOrDefaultAsync();

                if (so is not null && so.Id.Equals(id))
                {
                    ShopOrderStatus Status = so.Status;
                    if (so.Status != ShopOrderStatus.Unpaid)
                    {
                        cts.Cancel();
                        timer.Dispose();
                        NavigationManager.NavigateTo("/OrderConfirmation/" + id.ToString(), forceLoad: true);
                    }
                    else
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
        }
        catch(OperationCanceledException)
        {
            Dispose();
        }
    }

    private void UpdateOrder()
    {
        if (!id.Equals(Guid.Empty) && Service.ShopOrderExists(id))
        {
            Order = Service.GetShopOrder(id);
        }
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }
        NavigationManager.LocationChanged -= OnLocationChanged;
        cts.Cancel();
        cts.Dispose();
        _disposed = true;
    }

    public void SwishTrigger()
    {
        ShowIframe = !ShowIframe;
    }

    public async Task SwishButtonTrigger()
    {
        //stäng av timer
        Dispose();

        //uppdatera shoporder status till swishtriggered
        Order.Status = ShopOrderStatus.SwishTriggered;
        BeService.DbContext.ShopOrders.Update(Order);
        BeService.DbContext.SaveChanges();

        //gå vidare till orderconfimation och swishlänk
        await JSRuntime.InvokeVoidAsync("open2links");
    }


}

@if (Order is not null && Order.Status == ShopOrderStatus.Unpaid)
{
    <PageTitle>Betalning order @id</PageTitle>
    <h1>Betalning</h1>
    @* qr-kod *@
    <Image Src=@QrEmbeddedImage Alt="Scanna med din mobilkamera för att betala din order" />
    @* knapp *@
    <Button Color="ButtonColor.Primary" @onclick="() => SwishButtonTrigger()">Klicka här för att swisha från denna enheten</Button>
    @* <a href="https://app.swish.nu/1/p/sw/?sw=0735019697&amt=100&cur=SEK&msg=lol&src=qr" target="_blank">
        Länk
    </a> *@


    <p>SwishRedirectUrl: @SwishRedirectUrl</p>@*ta bort, behöver inte synas*@
    <p>SwishDirect: @SwishDirectUrl</p>@*ta bort, behöver inte synas*@
    <p>OrderConfirmationUrl: @OrderConfirmationUrl</p>@*ta bort, behöver inte synas*@
    <p>OrderStatus: @Order.Status</p>@*ta bort, behöver inte synas*@

    
    @* komponent som skall visa alla items i varukorgen *@
    @* används både på betalningssidan (denna) och orderbekräftelsesidan *@
    <PaymentCartViewer CartItems=@Order.Cart.CartItems />@*mycket att snygga till här*@

    @* komponent som skall visa all kundinformation *@
    @* används både på betalningssidan (denna) och orderbekräftelsesidan *@
    <CustomerInfoViewer CustomerInfo=@Order.CustomerInfo />@*mycket att snygga till här*@

    @if (ShowIframe)
    {
        <IframeViewer Url="@SwishRedirectUrl" Width="0" Height="0" />
    }

    @* raden nedan injicerar scriptet som triggar sidbyte och öppnar swish på mobilen*@
    @((MarkupString)TheScript)
}
else
{
    <Spinner />
}
