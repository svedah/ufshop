@page "/payment/{id:guid}"
@using Microsoft.EntityFrameworkCore
@using ufshop.Components.Account
@using ufshop.Data
@using ufshop.Data.Models
@using ufshop.Helpers
@using ufshop.Services
@using ufshop.Shared
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization

@inject IServiceProvider Services
@inject NavigationManager NavigationManager

@code {
    [Parameter]
    public Guid id { get; set; } //order id
    private ShopOrder Order { get; set; }
    private bool ShowIframe { get; set; }
    private CancellationTokenSource cts;
    private readonly BeService BeService;
    private readonly PaymentService Service;

    private string SwishRedirectUrl = string.Empty;
    private string QrEmbeddedImage = string.Empty;

    public Payment(BeService beService)
    {
        BeService = beService;
        Service = new PaymentService(beService);
        cts = new CancellationTokenSource();
        ShowIframe = false;
    }

    protected override async Task OnInitializedAsync()
    {
        SwishRedirectUrl = Service.BuildSwishRedirectUrl(id);
        QrEmbeddedImage = QrImageHelper.MakeEmbeddedImage(SwishRedirectUrl);
        UpdateOrder();
        if (Order is not null)
        {
            _ = RunLoopAsync(cts.Token);
        }
    }

    private async Task RunLoopAsync(CancellationToken token)
    {
        PeriodicTimer timer = new PeriodicTimer(TimeSpan.FromSeconds(3));

        while (await timer.WaitForNextTickAsync(token))
        {
            using IServiceScope scope = Services.CreateScope();
            ApplicationDbContext db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

            ShopOrder so = await db.ShopOrders.Where(e => e.Id.Equals(id)).FirstOrDefaultAsync();

            if (so is not null && so.Id.Equals(id))
            {
                ShopOrderStatus Status = so.Status;
                if (so.Status != ShopOrderStatus.Unpaid)
                {
                    NavigationManager.NavigateTo("/OrderConfirmation/" + id.ToString(), forceLoad: true);
                    cts.Cancel();
                }
                else
                {
                    await InvokeAsync(StateHasChanged);
                }
            }

        }
    }

    private void UpdateOrder()
    {
        if (!id.Equals(Guid.Empty) && Service.ShopOrderExists(id))
        {
            Order = Service.GetShopOrder(id);
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }

    public void SwishTrigger()
    {
        ShowIframe = !ShowIframe;
    }
}

@if (Order is not null && Order.Status == ShopOrderStatus.Unpaid)
{
    <PageTitle>Betalning order @id</PageTitle>
    <h1>Betalning</h1>
    @* qr-kod *@
    <Image Src=@QrEmbeddedImage Alt="Scanna med din mobilkamera för att betala din order" />
    @* knapp *@
    <Button Color="ButtonColor.Primary" @onclick="() => SwishTrigger()">Swisha från denna enheten</Button>

    <p>SwishRedirect: @SwishRedirectUrl</p>@*ta bort, behöver inte synas*@

    @* komponent som skall visa alla items i varukorgen *@
    @* används både på betalningssidan (denna) och orderbekräftelsesidan *@
    <PaymentCartViewer CartItems=@Order.Cart.CartItems />@*mycket att snygga till här*@

    @* komponent som skall visa all kundinformation *@
    @* används både på betalningssidan (denna) och orderbekräftelsesidan *@
    <CustomerInfoViewer CustomerInfo=@Order.CustomerInfo />@*mycket att snygga till här*@

    @if (ShowIframe)
    {
        <IframeViewer Url="@SwishRedirectUrl" Width="0" Height="0" />
    }
}
else
{
    <Spinner />
}
