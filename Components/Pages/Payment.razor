@page "/payment/{id:guid}"
@using Microsoft.EntityFrameworkCore
@using ufshop.Components.Account
@using ufshop.Data
@using ufshop.Data.Models
@using ufshop.Helpers
@using ufshop.Services
@using ufshop.Shared
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization

@inject IServiceProvider Services
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime;

@implements IDisposable

@code {
    [Parameter]
    public Guid id { get; set; } //order id
    private ShopOrder Order { get; set; }
    private bool ShowIframe { get; set; }

    private CancellationTokenSource cts;
    private bool _disposed = false;
    private Random random = new Random();
    private readonly BeService BeService;
    private readonly PaymentService Service;

    //för qr-kod
    private string SwishRedirectUrl = string.Empty;
    private string QrEmbeddedImage = string.Empty;

    //för knapp
    private string SwishDirectUrl = string.Empty;
    private string OrderConfirmationUrl = string.Empty;
    private string TheScript
    {
        get
        {
            return "<script>function open2links(){window.location.href=\"" + @OrderConfirmationUrl + "\";window.open(\"" + @SwishDirectUrl + "\", \"_blank\");}</script>";
        }
    }

    public Payment(BeService beService)
    {
        BeService = beService;
        Service = new PaymentService(beService);
        cts = new CancellationTokenSource();
        ShowIframe = false;
    }

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;

        //för qr-kod
        SwishRedirectUrl = Service.BuildSwishRedirectUrl(id);
        QrEmbeddedImage = QrImageHelper.MakeEmbeddedImage(SwishRedirectUrl);

        //för knapp
        SwishDirectUrl = Service.BuildSwishDirectUrl(id);
        OrderConfirmationUrl = Service.BuildOrderConfirmationUrl(id);

        UpdateOrder();
        if (Order is not null)
        {
            _ = RunLoopAsync(cts.Token);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        cts.Cancel();
    }

    private async Task RunLoopAsync(CancellationToken token)
    {
        //kolla var 3:e sekund om ordern bytt status från unpaid
        //när orderstatus bytt till inte unpaid (swishtriggered)
        //länkas sidan automatiskt vidare till orderconfirmation/guid
        PeriodicTimer timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                using IServiceScope scope = Services.CreateScope();
                ApplicationDbContext db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

                ShopOrder so = await db.ShopOrders.Where(e => e.Id.Equals(id)).FirstOrDefaultAsync();

                if (so is not null && so.Id.Equals(id))
                {
                    ShopOrderStatus Status = so.Status;
                    if (so.Status != ShopOrderStatus.Unpaid)
                    {
                        cts.Cancel();
                        timer.Dispose();
                        NavigationManager.NavigateTo("/OrderConfirmation/" + id.ToString(), forceLoad: true);
                    }
                    else
                    {
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
        }
        catch(OperationCanceledException)
        {
            Dispose();
        }
    }

    private void UpdateOrder()
    {
        if (!id.Equals(Guid.Empty) && Service.ShopOrderExists(id))
        {
            Order = Service.GetShopOrder(id);
        }
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }
        NavigationManager.LocationChanged -= OnLocationChanged;
        cts.Cancel();
        cts.Dispose();
        _disposed = true;
    }

    public void SwishTrigger()
    {
        ShowIframe = !ShowIframe;
    }

    public async Task SwishButtonTrigger()
    {
        //stäng av timer
        Dispose();

        //uppdatera shoporder status till swishtriggered
        Order.Status = ShopOrderStatus.SwishTriggered;
        BeService.DbContext.ShopOrders.Update(Order);
        BeService.DbContext.SaveChanges();

        //gå vidare till orderconfimation och swishlänk
        await JSRuntime.InvokeVoidAsync("open2links");
    }


}

@if (Order is not null && Order.Status == ShopOrderStatus.Unpaid)
{
    <PageTitle>Betalning order @id</PageTitle>

    <div class="container my-4">
        <!-- Header -->
        <div class="text-center mb-4">
            <h1 class="fw-bold text-primary">
                <i class="bi bi-credit-card me-2"></i>Betalning
            </h1>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-5">
                <div class="card">
                    <div class="card-header bg-primary text-white text-center">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-qr-code me-2"></i>Betala med Swish
                        </h5>
                    </div>
                    <div class="card-body text-center d-flex flex-column justify-content-start py-4">
                        <div class="mb-4">
                            <Image Src="@QrEmbeddedImage" 
                                Alt="Scanna med din mobilkamera för att betala din order" 
                                class="img-fluid shadow rounded"
                                style="max-width: 280px; width: 100%;" />
                        </div>
                        
                        <div class="alert alert-info d-flex align-items-center justify-content-center mb-4" role="alert">
                            <i class="bi bi-info-circle-fill me-2 flex-shrink-0"></i>
                            <div class="text-start">
                                <strong>Öppna Swish-appen och skanna QR-koden ovan</strong>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <Button Color="ButtonColor.Primary" Size="ButtonSize.Large" class="fw-bold d-flex align-items-center justify-content-center" @onclick="() => SwishButtonTrigger()">
                                <i class="bi bi-phone-fill me-2"></i>
                                Öppna Swish på denna enhet
                            </Button>
                        </div>

                        <small class="text-muted">
                            Order ID: #@id
                        </small>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-7">
                <div class="d-flex flex-column gap-4">
                    <!-- Cart Items -->
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0 fw-semibold">
                                <i class="bi bi-cart3 me-2"></i>Din beställning
                            </h6>
                        </div>
                        <div class="card-body">
                            <PaymentCartViewer CartItems="@Order.Cart.CartItems" />
                        </div>
                    </div>

                    <!-- Customer Info -->
                    <div class="card">
                        <div class="card-header">
                            <h6 class="mb-0 fw-semibold">
                                <i class="bi bi-person-lines-fill me-2"></i>Leveransinformation
                            </h6>
                        </div>
                        <div class="card-body">
                            <CustomerInfoViewer CustomerInfo="@Order.CustomerInfo" />
                        </div>
                    </div>

                    <!-- Order Status -->
                    <div class="card border-primary">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="mb-1 fw-semibold">Betalningsstatus</h6>
                                    <p class="mb-0 text-muted small">
                                        Väntar på betalning via Swish
                                    </p>
                                </div>
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Väntar...</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (ShowIframe)
        {
            <IframeViewer Url="@SwishRedirectUrl" Width="0" Height="0" />
        }

        @* Injicerar scriptet som triggar sidbyte och öppnar swish på mobilen *@
        @((MarkupString)TheScript)
    </div>

}
else
{
    <Spinner />
}
