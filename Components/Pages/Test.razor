@page "/test"
@using ufshop.Helpers
@rendermode InteractiveServer

<PageTitle>Test</PageTitle>

<hr />
<OrderShop />
<hr />

<h1>Test</h1>
<p>@myBoolean.ToString()</p>
<button @onclick="SwitchFunction">Switch</button>
<Image Src=@EmbeddedImage Alt="Test" />
<img src=@EmbeddedImage Alt="Test 2" />

@code
{
    private bool myBoolean = false;

    private string EmbeddedImage = string.Empty;

    public Test()
    {
        EmbeddedImage = QrImageHelper.MakeEmbeddedImage("https://www.google.com/");
    }

    private void SwitchFunction()
    {
        myBoolean = !myBoolean;
    }

}

