@page "/"
@using ufshop.Services

@* the following will redirect to authentication immediately if not authenticated *@
@* @attribute [Authorize] *@ 

@rendermode InteractiveServer
@* @inject ufshop.Services.BeService BeService *@
@inject IJSRuntime JSRuntime
@code {
    private readonly BeService beService;
    private readonly HomePageService Service;
    public Home(ufshop.Services.BeService srv)
    {
        beService = srv;
        Service = new HomePageService(beService);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        @* if (firstRender) *@
        {
            await JSRuntime.InvokeVoidAsync("applyThemeSwitcher");
        }
    }

}
<PageTitle>Home</PageTitle>
<HeadContent>
    @* <meta name="headcontent" description="lol yep!" /> *@
</HeadContent>
@* <h1>Hello, world!</h1> *@
@* <p>@wwwPath</p> *@
@* <p>@Service.beService.DomainPrefix</p> *@
@* <AuthorizeView>
    Hello @context.User.Identity?.Name!
</AuthorizeView> *@
<div class="container py-4">
    <div class="row align-items-center mb-4 px-md-5">

        <div class="col-12 col-sm-8 order-2 order-sm-1 text-center text-md-start">
            <h1 class="display-5 display-md-4 fw-bold mb-3">
                @Service.Title
            </h1>
            <p class="lead lead mb-0">
                @Service.Description
            </p>
        </div>

        <div class="col-12 col-sm-4 order-1 order-sm-2 text-center text-sm-end mb-3 mb-md-0">
            <Image Src="@Service.LogoImageFile" Alt="@Service.LogoImageAltText" 
            class="img-fluid rounded-4 shadow-sm
                    w-75 w-sm-100 w-md-75 w-lg-100"/>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <PagesTabs Pages=Service.Pages Items=Service.ShopItems />
        </div>
    </div>
</div>



