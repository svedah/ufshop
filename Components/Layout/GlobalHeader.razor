@using ufshop.Data.Models
@using ufshop.Services

@rendermode InteractiveServer
@inject UIStateService Ui
@code {
    public readonly BeService beService;
    public Shop shop;

    private CartService cartService;
    private int cartNumberOfItems = 0;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    public string ShopTitle;
    public ShopImage ShopLogo;

    public GlobalHeader(BeService srv)
    {
        beService = srv;
    }

    private void RefreshData()
    {
        shop = GetShop();
        ShopTitle = shop.Settings.Title;
        ShopLogo = shop.Settings.LogoImage;
        InvokeAsync(StateHasChanged);
    }

    private Shop GetShop()
    {
        Shop output;
        ShopService ss = new ShopService(beService);
        if (ss.GetShop(beService.DomainPrefix, out output))
        {
            return output;
        }
        return default!;
    }

    private async Task RefreshCartIcon()
    {
        cartNumberOfItems = await cartService.CartNumberOfItems();
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));

        shop = GetShop();
        ShopTitle = shop.Settings.Title;
        ShopLogo = shop.Settings.LogoImage;
        cartService = new CartService(beService);

        _ = Task.Run(async ( ) => {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                await RefreshCartIcon();
            }
        });
    }

    protected override void OnInitialized()
    {
        Ui.OnChange += RefreshData;
    }

    public void Dispose()
    {
        Ui.OnChange -= RefreshData;

        _cts.Cancel();
        _cts.Dispose();
    }

}
@if (shop is not null)
{
    <header class="sticky-top ">
        <nav class="navbar navbar-expand-lg bg-primary-subtle shadow-sm mb-3 p-2 px-sm-4">
            <div class="container-fluid">
                <NavLink class="navbar-brand d-flex align-items-center" href="/">
                    @if (ShopLogo is not null)
                    {
                        string imageUrl = "/img/" + ShopLogo.Filename;
                        
                        <Image Src="@imageUrl" 
                                Alt="@ShopTitle" 
                                width="60px" 
                                class="shop-logo me-3 rounded shadow-sm" />
                        <span class="fw-bold m-0 fs-5 d-none d-sm-inline text-nowrap">
                            @ShopTitle
                        </span>
                    }
                    else
                    {
                        <Icon Name="IconName.House" class="text-primary me-2"/>
                        <span class="fw-bold  m-0 fs-5 d-none d-sm-inline text-nowrap">
                            @ShopTitle
                        </span>
                    }
                </NavLink>

                @inject NavigationManager NavigationManager

                @code {
                    private void GoToCart()
                    {
                        
                        NavigationManager.NavigateTo("/checkout", forceLoad: true);
                    }
                }
                
                <!-- Höger Sida -->
                <div class="d-flex align-items-center gap-2">
                    
                    <ThemeSwitcher class="btn btn-primary btn-sm"/>
                    <NavLink class="btn btn-primary position-relative px-3 py-2" @onclick="GoToCart">
                        <Icon Name="IconName.Cart" />
                        <span class="d-none d-md">Varukorg</span>
                        
                        @* todo gör att den faktiskt visar rätt tal *@
                        @if(cartNumberOfItems > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @if (cartNumberOfItems > 9)
                            {
                                <span>+</span>
                            }
                            else
                            {
                                @cartNumberOfItems
                            }
                            </span>
                        }
                    </NavLink>
                </div>
            </div>
        </nav>
    </header>
}

<style>


#bb-theme-text {
    display: none !important;
}

    /* Logo sizing - responsive */
    .shop-logo {
        width: 45px;
        height: 45px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    
    .shop-logo:hover {
        transform: scale(1.05);
    }
    

    .navbar-brand:hover .shop-logo {
        transform: rotate(5deg) scale(1.05);
    }
    
    /* Button hover effects */
    .btn {
        transition: all 0.3s ease;
    }
    
    .btn:hover {
        transform: translateY(-2px);
    }
    
    .btn-primary:hover {
        box-shadow: 0 4px 8px rgba(13, 110, 253, 0.3);
    }
    

</style>
