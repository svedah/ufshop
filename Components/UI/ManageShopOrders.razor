@using ufshop.Data.Models
@using ufshop.Services
@using ufshop.Shared
@namespace ufshop.Components.UI
@rendermode InteractiveServer

@code {

    private readonly BeService BeService;
    private readonly ManageShopOrdersService Service;

    private List<ShopOrder> ShopOrders { get; set; } = new List<ShopOrder>();
    private IEnumerable<Tuple<string, string>> OrderDataList { get; set; } = new List<Tuple<string, string>>();
    
    private ShopOrder SearchShopOrder { get; set; }
    private int SelectedFilter { get; set; }
    private string? SelectedSearchTerm;

    public ManageShopOrders(BeService srv)
    {
        BeService = srv;
        Service = new ManageShopOrdersService(srv);
        SelectedFilter = 4; // swish har triggats
        SearchShopOrder = new ShopOrderService(srv).Empty();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        @* await Reload(); *@
        ShopOrders = Service.GetAllShopOrders();
        OrderDataList = Service.GetAllShopOrdersDataList();
    }

    private async Task Reload()
    {
        @* ShopOrders = Service.GetAllShopOrders(); *@
        ShopOrders = Service.GetFilteredShopOrders(SelectedFilter);
        StateHasChanged();
    }

    private void SearchOrderInputChanged(ChangeEventArgs e)
    {
        if (e is not null && e.Value is not null)
        {
            SelectedSearchTerm = e.Value.ToString();
            Guid searchOrderId = Guid.Empty;
            if (Guid.TryParse(SelectedSearchTerm, out searchOrderId))
            {
                ShopOrder searchedShopOrder = Service.GetShopOrder(searchOrderId);
                if (searchedShopOrder.Id.Equals(searchOrderId))
                {
                    SearchShopOrder = searchedShopOrder;
                }
            }
            else
            {
                SearchShopOrder = new ShopOrderService(BeService).Empty();
            }
        }
    }

    private void SelectFilterChange(ChangeEventArgs e)
    {
        int selectedFilter = -1;
        if (int.TryParse(e.Value.ToString(), out selectedFilter))
        {
            SelectedFilter = selectedFilter;
            ShopOrders = Service.GetFilteredShopOrders(selectedFilter);
        }
    }

}
@if (ShopOrders is null)
{
    <Spinner />
}
else
{
    <div class="container my-4">

        <!-- Header -->
        <div class="text-center mb-5">
            <h1 class="fw-bold text-primary">
                <i class="bi bi-box-seam me-2"></i>Beställningar
            </h1>
        </div>

        <!-- Ordersök -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-funnel me-2"></i>Sök beställning
                </h6>
            </div>
            <div class="card-body">
                @* <p>SelectedSearchTerm: @SelectedSearchTerm</p> *@
                <input 
                    type="text"
                    class="form-control"
                    pattern="[0-9a-fA-F]{8}" 
                    list="searchorderdatalist"
                    @oninput="SearchOrderInputChanged"
                    />
                    @* @bind="SelectedSearchTerm" *@
                <datalist id="searchorderdatalist">
                    @foreach(Tuple<string, string> item in OrderDataList)
                    {
                        <option value="@item.Item1">@item.Item2</option>
                    }
                </datalist>
                @if(SearchShopOrder is not null && !SearchShopOrder.Id.Equals(Guid.Empty))
                {
                    string accordionTitle = SearchShopOrder.Created.ToString("yyyy-MM-dd HH:mm") + " • " + SearchShopOrder.CustomerInfo.FirstName + " " + SearchShopOrder.CustomerInfo.LastName + " • " + SearchShopOrder.CustomerInfo.City;
                    <Accordion>
                        <AccordionItem Title="@accordionTitle">
                            <Content>
                                <ManageShopOrder Id="@SearchShopOrder.Id" ShopOrder="@SearchShopOrder" />            
                            </Content>
                        </AccordionItem>
                    </Accordion>
                }
            </div>
        </div>

        <!-- Filter -->
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-funnel me-2"></i>Filtrera beställningar
                </h6>
                <Button class="btn btn-sm" Color="ButtonColor.Primary" @onclick="Reload">
                    <Icon Name="IconName.ArrowClockwise" />
                </Button>
            </div>
            <div class="card-body">
                <select class="form-select" @onchange="SelectFilterChange">
                    <option selected disabled>Välj filter...</option>
                    <option value="1">Betalda</option>
                    <option value="2">Levererade</option>
                    <option value="3">Avvisade</option>
                    <option value="4">Eventuellt betalda</option>
                    <option value="0">Ej betalda</option>
                    <option value="-1">Alla</option>
                </select>
            </div>
        </div>

        <!-- Beställningar Lista -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-list-ul me-2"></i>Beställningar
                </h6>
                <span class="badge bg-primary">@ShopOrders.Count() st</span>
            </div>
            <div class="card-body p-0">
                @if (ShopOrders.Any())
                {
                    <Accordion>
                        @foreach(ShopOrder shopOrder in ShopOrders)
                        {
                            string accordionTitle = shopOrder.Created.ToString("yyyy-MM-dd HH:mm") + " • " + shopOrder.CustomerInfo.FirstName + " " + shopOrder.CustomerInfo.LastName + " • " + shopOrder.CustomerInfo.City;
                            <AccordionItem Title="@accordionTitle">
                                <Content>
                                    <ManageShopOrder Id="@shopOrder.Id" ShopOrder="@shopOrder" />
                                </Content>
                            </AccordionItem>
                        }
                    </Accordion>
                }
                else
                {
                    <div class="text-center py-5 px-3 text-muted">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2 mb-0">Inga beställningar hittades med det valda filtret</p>
                    </div>
                }
            </div>
        </div>
    </div>
}
