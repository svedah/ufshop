@using ufshop.Data.Models
@using ufshop.Services
@rendermode InteractiveServer
@code {
    public readonly BeService beService;
    public readonly CartService cartService;
    public List<CartItem> CartContent;
    public readonly int ShippingPrice = -1;

    [Parameter]
    public EventCallback<bool> OnValidityChanged { get; set; }

    public int CartContentSum
    {
        get
        {
            int output = 0;
            foreach(CartItem cartItem in CartContent)
            {
                output += cartItem.ShopItem.Price * cartItem.Amount;
            }
            return output;
        }
    }

    
    public CartEditor(BeService srv)
    {
        beService = srv;
        cartService = new CartService(beService);
        CartContent = new List<CartItem>();
        ShippingPrice = GetShippingPrice();
    }

    private int GetShippingPrice()
    {
        Shop shop;
        ShopService ss = new ShopService(beService);
        if (ss.GetShop(beService.DomainPrefix, out shop))
        {
            return shop.Settings.BaseShippingPrice;
        }
        return ufshop.Shared.Constants.BASESHIPPINGPRICE;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CartContent = await cartService.GetCartContent();
            ValidityChanged();
            StateHasChanged();
        }
        @* AJABAJA INTE UTAN firstRender CartContent = await cartService.GetCartContent(); *@
    }
    
    public async Task ValidityChanged()
    {
        bool result = cartService.IsValid(CartContent);
        await OnValidityChanged.InvokeAsync(result);
    }

    private async Task HandleChangeItem()
    {
        var cartContent = await cartService.GetCartContent();
        CartContent = cartContent;
        await ValidityChanged();
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteCart()
    {
        CartContent = await cartService.EmptyCartContent();
        await ValidityChanged();
        await InvokeAsync(StateHasChanged);
    }

}
<div class="container my-4">
    <!-- Header -->
<div class="card mb-4">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-cart3 me-2"></i>Varukorg
            </h5>
            <span class="badge bg-primary fs-6">@CartContent.Count st</span>
        </div>
    </div>

    <!-- Cart Items -->
    <ul class="list-group list-group-flush">
        @if (CartContent.Any())
        {
            @foreach(CartItem cartItem in CartContent)
            {
                <li class="list-group-item">
                    <CartEditorItem @key="@cartItem.Id" Id="@cartItem.Id" OnChange="HandleChangeItem" />
                </li>
            }
        }
        else
        {
            <li class="list-group-item text-center py-5 text-muted">
                <i class="bi bi-cart-x fs-1"></i>
                <p class="mt-2 mb-0">Din varukorg är tom</p>
            </li>
        }
    </ul>

    @if (CartContent.Any())
    {
        <div class="card-footer border-top">
            <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" Class="w-100" @onclick="() => DeleteCart()">
                <Icon Name="IconName.Trash" /> Töm Varukorg
            </Button>
        </div>
    }
</div>

    @if (CartContent.Count > 0)
    {
        <!-- Pris Sammanfattning -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-calculator me-2"></i>Sammanfattning
                </h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Varupris:</span>
                    <span class="fw-semibold">@CartContentSum kr</span>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="text-muted">Fraktpris:</span>
                    <span class="fw-semibold">@ShippingPrice kr</span>
                </div>
                @{
                    int total = CartContentSum + ShippingPrice;
                }
                <div class="d-flex justify-content-between">
                    <span class="fs-5 fw-bold">Totalt:</span>
                    <span class="fs-5 fw-bold text-primary">@total kr</span>
                </div>
            </div>
        </div>
    }
</div>