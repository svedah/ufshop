@using SQLitePCL
@using ufshop.Data.Models
@using ufshop.Services
@rendermode InteractiveServer
@code {
    private readonly BeService beService;
    private readonly AdministrationCreateShopService Service;

    private IQueryable<UFShopOrder> AllUfShopOrders
    {
        get
        {
            return Service.AllUfShopOrders()
                .Where(e => e.Prefix != "www")
                .Where(e => !e.Active)
                .Where(e => !e.Paid)
                .OrderBy(e => e.Prefix);
        }
    }

    private UFShopOrder SelectedUFShopOrder { get; set; }
    private string SelectedUFPassword { get; set; }

    private Modal modal = default;

    public AdministrationCreateShop(BeService srv)
    {
        beService = srv;
        Service = new AdministrationCreateShopService(srv);
        SelectedUFShopOrder = GetEmptyUFShopOrder();
        SelectedUFPassword = string.Empty;
    }

    private UFShopOrder GetEmptyUFShopOrder()
    {
        return Service.EmptyUfShopOrder();
    }

    private bool ButtonCreateShopDisabled
    {
        get
        {
            return  SelectedUFShopOrder.Id.Equals(Guid.Empty) ||
                    !Service.IsValid(SelectedUFShopOrder) ||
                    string.IsNullOrWhiteSpace(SelectedUFPassword);
        }
    }

    private bool ButtonDeleteShopDisabled
    {
        get
        {
            return SelectedUFShopOrder.Id.Equals(Guid.Empty);
        }
    }

    private async Task CreateNewShopAndUser()
    {
        bool result = Service.CreateNewShop(SelectedUFShopOrder, SelectedUFPassword);
        if (result)
        {
            //set paid and active on ufshoporder if successfully created shop
            Service.MarkPaidAndActive(SelectedUFShopOrder);

            //pop up modal for Lara
            //with relevant info on created shop
            await modal.ShowAsync();
        }
    }

    private async Task CloseModal()
    {
        await modal.HideAsync();
    }

    private void DeleteSelectedUFShopOrder()
    {
        Service.DeleteUfShopOrder(SelectedUFShopOrder.Id);
        SelectedUFShopOrder = Service.EmptyUfShopOrder();
    }

    private void GenerateNewPassword()
    {
        SelectedUFPassword = Helpers.PasswordHelper.GetRandomizedPassword();
    }

    private void SelectItemChange(ChangeEventArgs e)
    {
        Guid SelectedId = Guid.Empty;
        if (e is not null && e.Value is not null)
        {
            if (Guid.TryParse(e.Value.ToString(), out SelectedId))
            {
                UFShopOrder ufShopOrder;
                if (Service.GetUFShopOrder(SelectedId, out ufShopOrder))
                {
                    SelectedUFShopOrder = ufShopOrder;
                }
            }
        }
    }

}

@if (beService is null)
{
    <Spinner />
}
else
{

    <div class="container my-4">
        <!-- Header -->
        <div class="text-center mb-5">
            <h1 class="fw-bold text-primary">
                <i class="bi bi-shop-window me-2"></i>Skapa ny shop
            </h1>
        </div>

        <!-- Välj Order -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-list-check me-2"></i>Välj UF-shop beställning
                </h6>
            </div>
            <div class="card-body">
                <select class="form-select form-select-lg" @onchange="SelectItemChange">
                    <option selected disabled>Välj beställning...</option>
                    @foreach(UFShopOrder o in AllUfShopOrders)
                    {
                        <option value="@o.Id">@o.Created.ToString("yyyy-MM-dd") • @o.Prefix</option>
                    }
                </select>
            </div>
        </div>

        <!-- Order Detaljer -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-pencil-square me-2"></i>Shopinformation
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <!-- ID -->
                    <div class="col-12">
                        <small class="text-muted d-block">Order-ID</small>
                        <code class="fs-6">@SelectedUFShopOrder.Id</code>
                    </div>

                    <!-- Titel -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Titel</label>
                        <TextInput @bind-Value="@SelectedUFShopOrder.Title" 
                                class="form-control" 
                                placeholder="Företagsnamn" />
                    </div>

                    <!-- URL -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Domänprefix</label>
                        <div class="input-group">
                            <span class="input-group-text d-none d-sm-flex">https://</span>
                            <TextInput @bind-Value="@SelectedUFShopOrder.Prefix" 
                                    class="form-control rounded-start d-sm-none" 
                                    placeholder="prefix" />
                            <TextInput @bind-Value="@SelectedUFShopOrder.Prefix" 
                                    class="form-control d-none d-sm-flex" 
                                    placeholder="prefix" />
                            <span class="input-group-text">.ufshop.nu</span>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">E-post</label>
                        <TextInput @bind-Value="@SelectedUFShopOrder.Email" 
                                type="email"
                                class="form-control" 
                                placeholder="kontakt@exempel.se" />
                    </div>

                    <!-- Mobilnummer -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Telefon</label>
                        <TextInput @bind-Value="@SelectedUFShopOrder.Phone" 
                                type="tel"
                                class="form-control" 
                                placeholder="07X-XXX XX XX" />
                    </div>

                    <!-- Checkboxes -->
                    <div class="col-12">
                        <label class="form-label fw-semibold d-block mb-2">Inställningar</label>
                        <div class="row g-2">
                            <div class="col-6 col-md-3">
                                <div class="form-check form-switch">
                                    <CheckboxInput Label="UF Företag" 
                                                @bind-Value="@SelectedUFShopOrder.UF" 
                                                class="form-check-input" />
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="form-check form-switch">
                                    <CheckboxInput Label="Assisterad" 
                                                @bind-Value="@SelectedUFShopOrder.Assisted" 
                                                class="form-check-input" />
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="form-check form-switch">
                                    <CheckboxInput Label="Aktiv" 
                                                @bind-Value="@SelectedUFShopOrder.Active" 
                                                class="form-check-input" />
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="form-check form-switch">
                                    <CheckboxInput Label="Betald" 
                                                @bind-Value="@SelectedUFShopOrder.Paid" 
                                                class="form-check-input" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Lösenord -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-key me-2"></i>Lösenord
                        </label>
                        <div class="input-group">
                            <TextInput @bind-Value="@SelectedUFPassword" 
                                    class="form-control" 
                                    placeholder="Ange lösenord" />
                            <Button Color="ButtonColor.Primary" @onclick="() => GenerateNewPassword()">
                                <i class="bi bi-arrow-clockwise me-1"></i> Generera
                            </Button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Knappar -->
        <div class="d-flex gap-2 justify-content-end flex-wrap">
            <Button Color="ButtonColor.Danger"
                    Size="ButtonSize.Large"
                    Disabled="@ButtonDeleteShopDisabled"
                    @onclick="() => DeleteSelectedUFShopOrder()">
                <i class="bi bi-trash me-2"></i>Ta bort beställning
            </Button>
            <Button Color="ButtonColor.Success" 
                    Size="ButtonSize.Large"
                    Disabled="@ButtonCreateShopDisabled"
                    @onclick="() => CreateNewShopAndUser()">
                <i class="bi bi-plus-circle me-2"></i>Skapa shop
            </Button>
        </div>

        <Modal @ref="modal" title="Shop skapad" IsVerticallyCentered="true">
            <BodyTemplate>

                @{string fullUrl = "https://" + SelectedUFShopOrder.Prefix + ".ufshop.nu/";}
                
                <div class="card">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Inloggningsuppgifter</h6>
                        
                        <div class="mb-3">
                            <small class="text-muted d-block">Webbadress</small>
                            <a href="@fullUrl" target="_blank" class="fw-semibold">@fullUrl</a>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted d-block">Användarnamn</small>
                            <code>@SelectedUFShopOrder.Email</code>
                        </div>

                        <div class="mb-0">
                            <small class="text-muted d-block">Lösenord</small>
                            <code>@SelectedUFPassword</code>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info mt-3 mb-0" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    <small>Kopiera denna information och skicka till kunden via e-post</small>
                </div>
            </BodyTemplate>
            <FooterTemplate>
                <Button Color="ButtonColor.Primary" @onclick="CloseModal">
                    <i class="bi bi-check-lg me-2"></i>Stäng
                </Button>
            </FooterTemplate>
        </Modal>
    </div>







