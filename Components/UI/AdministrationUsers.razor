@using Microsoft.AspNetCore.Identity
@using ufshop.Data.Models
@using ufshop.Services
@rendermode InteractiveServer
@code {
    private readonly BeService beService;
    private readonly AdministrationUsersService Service;

    private IQueryable<IdentityUser> AllUsers
    {
        get
        {
            return Service.AllUsers()
                .OrderBy(e => e.Email);
        }
    }

    private IdentityUser SelectedUser { get; set; }
    private string SelectedUserPassword { get; set; }


    public AdministrationUsers(BeService srv)
    {
        beService = srv;
        Service = new AdministrationUsersService(srv);
        SelectedUser = GetEmptyUser();
        SelectedUserPassword = string.Empty;
    }

    private IdentityUser GetEmptyUser()
    {
        return Service.EmptyUser();
    }

    private bool ButtonChangeUserDisabled
    {
        get
        {
            return ButtonBlockUserDisabled || SelectedUserPassword.Length == 0;
        }
    }

    private bool ButtonBlockUserDisabled
    {
        get
        {
            return SelectedUser.Id.Equals(Guid.Empty.ToString());
        }
    }

    private void BlockSelectedUser()
    {
        SelectedUserPassword = Guid.NewGuid().ToString(); //lycka till gissa lösenordet
        SetNewUserPassword();
        //clear form
        SelectedUser = Service.EmptyUser();
        SelectedUserPassword = string.Empty;
    }

    private void SetNewUserPassword()
    {
        Service.SetPassword(SelectedUser.Id, SelectedUserPassword);
    }

    private void GenerateNewPassword()
    {
        SelectedUserPassword = Helpers.PasswordHelper.GetRandomizedPassword();
    }
    private void SelectItemChange(ChangeEventArgs e)
    {
        Guid SelectedId = Guid.Empty;
        if (e is not null && e.Value is not null)
        {
            if (Guid.TryParse(e.Value.ToString(), out SelectedId))
            {
                IdentityUser user;
                if (Service.GetUser(SelectedId, out user))
                {
                    SelectedUser = user;
                    SelectedUserPassword = string.Empty;
                }
            }
        }
    }



}

@if (beService is null)
{
    <Spinner />
}
else
{
    <div class="container my-4">
        <!-- Header -->
        <div class="text-center mb-4">
            <h1 class="fw-bold text-primary">
                <i class="bi bi-people me-2"></i>Användarhantering
            </h1>
        </div>

        <!-- Välj Användare -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-person-check me-2"></i>Välj användare
                </h6>
            </div>
            <div class="card-body">
                <select class="form-select form-select-lg" @onchange="SelectItemChange">
                    <option selected disabled>Välj användare...</option>
                    @foreach(IdentityUser o in AllUsers)
                    {
                        <option value="@o.Id">@o.Email</option>
                    }
                </select>
            </div>
        </div>

        <!-- Användar Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-person-badge me-2"></i>Vald användare
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3 mb-4">
                    <!-- Användar ID -->
                    <div class="col-12">
                        <small class="text-muted d-block">Användar-ID</small>
                        <code class="fs-6">@SelectedUser.Id</code>
                    </div>

                    <!-- Email -->
                    <div class="col-12">
                        <small class="text-muted d-block">E-post</small>
                        <span class="fw-semibold">@SelectedUser.Email</span>
                    </div>

                    <!-- Lösenord -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-key me-2"></i>Nytt lösenord
                        </label>
                        <div class="input-group">
                            <TextInput @bind-Value="@SelectedUserPassword" 
                                    class="form-control" 
                                    placeholder="Ange nytt lösenord" />
                            <Button Color="ButtonColor.Primary" @onclick="() => GenerateNewPassword()">
                                <i class="bi bi-arrow-clockwise me-1 d-none d-md-inline"></i> Generera
                            </Button>
                        </div>
                    </div>
                </div>

                <!-- Knappar -->
                <div class="d-flex gap-2 flex-column flex-md-row">
                    <Button Color="ButtonColor.Success" 
                            class="d-flex align-items-center justify-content-center w-100 w-md-auto"
                            @onclick="() => SetNewUserPassword()"
                            Disabled="@ButtonChangeUserDisabled">
                        <i class="bi bi-check-circle me-2"></i>Sätt nytt lösenord
                    </Button>
                    <Button Color="ButtonColor.Danger" 
                            class="d-flex align-items-center justify-content-center w-100 w-md-auto"
                            @onclick="() => BlockSelectedUser()"
                            Disabled="@ButtonBlockUserDisabled">
                        <i class="bi bi-ban me-2"></i>Blockera användare
                    </Button>
                </div>
            </div>
        </div>
    </div>
}
