@using System.Drawing
@using ufshop.Shared
@using ufshop.Services
@namespace ufshop.Components.UI
@rendermode InteractiveServer
@* @inject ufshop.Services.BeService BeService *@


@code {

    public readonly BeService beService;
    public readonly OrderShopService Service;

    //BEGIN Form bindings
    string Prefix { get; set; } = string.Empty;
    string Company { get; set; } = string.Empty;
    string Email { get; set; } = string.Empty;
    string Phone { get; set; } = string.Empty;
    @* string CompanyType { get; set; } = string.Empty; *@
    bool CompanyTypeUF { get; set; } = true;
    string CompanyTypeUFCheck
    {
        get
        {
            return CompanyTypeUF ? "checked" : string.Empty;
        }
    }
    bool Assisted { get; set; } = false;
    private bool IsFormDataValid { get { return Service.IsFormDataValid(Prefix, Company, Email, Phone); } }
    //END Form bindings

    private bool IsPrefixValid { get { return Service.IsValidPrefix(Prefix); } }

    private string PrefixCSS
    {
        get
        {
            string output = "margin:0;padding:0;text-align:right;";
            if (Prefix.Length > 0)
            {
                if (!IsPrefixValid)
                {
                    output += "border-color: var(--bs-danger);";
                }
                else
                {
                    output += "border-color: var(--bs-success);";
                }
            }

            return output;
        }
    }

    public string OrderId { get; set; }

    public OrderShop(BeService srv)
    {
        beService = srv;
        Service = new OrderShopService(beService);

        OrderId = string.Empty;
    }

    private void MakeOrder()
    {
        if (IsFormDataValid)
        {
            Guid orderId = Service.MakeOrder(Prefix, Company, Email, Phone, CompanyTypeUF, Assisted);
            if (!orderId.Equals(Guid.Empty))
            {
                OrderId = orderId.ToString().Split('-')[0];
            }
        }
    }

}

@* Lara: Kommentera bort dessa två knappar när du designat klart *@
@* <button @onclick="() => {OrderId = string.Empty;}">Formulär</button>
<button @onclick="() => {OrderId = Guid.NewGuid().ToString().Split('-')[0].ToUpper();}">Beställd</button> *@

@if (OrderId.Length > 0)
{
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12">
                <div class="d-grid text-center mb-4">
                    <Icon Name="IconName.CheckCircleFill"
                        Class="text-success mb-3"
                        Size="IconSize.x1" />

                    <h3 Class="fw-semibold mb-1">
                        Tack för er beställning!
                    </h3>

                    <p class="text-muted small mb-0">
                        Er beställning är mottagen
                    </p>
                </div>

                <div class="text-center my-4">
                    <p class="text-muted small mb-2">Ert ordernummer</p>
                    <Badge Color="BadgeColor.Primary"
                        VisuallyHiddenText="Ordernummer"
                        Class="fs-6 px-3 py-2 rounded-pill">
                        @OrderId
                    </Badge>
                </div>

                <Alert Color="AlertColor.Info" Class="mb-0 mt-4">
                    <Icon Name="IconName.InfoCircleFill" Class="me-2" />
                    <span class="fw-semibold">Vad händer nu?</span>

                    <ul class="mt-2 mb-0 ps-3 small">
                        <li class="mb-1">
                            Om beställningen godkänns får ni ett
                            <strong>kontrakt via e-post</strong>.
                        </li>
                        <li class="mb-1">
                            När betalning skett och kontraktet är
                            <strong>signerat och returnerat</strong> till oss
                            får ni ytterligare information med
                            <strong>inloggningsuppgifter till er UF-shop</strong>.
                        </li>
                    </ul>
                </Alert>
            </div>
        </div>
    </div>
}
else
{

    <div class="order-form">

        @* Shop namn och länk *@
        <section class="mb-4">
            <label class="form-label fw-semibold">
                <i class="bi bi-globe me-2"></i>Namn UF-shop
            </label>

            <div class="input-group input-group-lg">
                <span class="input-group-text border-end-0 d-none d-sm-flex">https://</span>
                
                <input @bind="Prefix"
                    type="text"
                    pattern="[a-z]{16}"
                    class="form-control border-end-0 text-center rounded-start d-sm-none"
                    placeholder="uf-namn"
                    style="@PrefixCSS"
                />
                <input @bind="Prefix"
                    type="text"
                    pattern="[a-z]{16}"
                    class="form-control border-start-0 border-end-0 text-center d-none d-sm-flex"
                    placeholder="uf-namn"
                    style="@PrefixCSS"
                />          
                <span class="input-group-text border-start-0">.ufshop.nu</span>
            </div>

            <small class="text-muted d-block mt-2">
                <i class="bi bi-info-circle me-1"></i>Endast små bokstäver, inga mellanslag
            </small>
        </section>


        @* Företags namn *@
        <section class="mb-4">
            <label class="form-label fw-semibold">
                <i class="bi bi-building me-2"></i>Företagsnamn
            </label>
            <InputText @bind-Value="Company" 
                        class="form-control form-control-lg" 
                        placeholder="Ditt företagsnamn"/>
        </section>
        
        @* Kontakt information *@
        <section class="card border mb-4">
            <div class="card-body p-4">
                <h6 class="fw-semibold mb-3 text-muted">
                    <i class="bi bi-person-lines-fill me-2"></i>KONTAKTINFORMATION
                </h6>

                <!-- Email -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">E-post adress</label>
                    <div class="input-group">
                        <span class="input-group-text d-none d-sm-flex">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <InputText @bind-Value="Email" 
                                type="email" 
                                class="form-control rounded d-sm-none" 
                                placeholder="din@email.se" />

                        <InputText @bind-Value="Email" 
                                type="email" 
                                class="form-control d-none d-sm-flex" 
                                placeholder="din@email.se" />
                    </div>
                    <small class="text-muted d-block mt-2">
                        <i class="bi bi-info-circle me-1"></i>Giltig E-post krävs
                    </small>
                </div>

                <!-- Phone -->
                <div class="mb-0">
                    <label class="form-label fw-semibold">Mobilnummer</label>
                    <div class="input-group">
                        <span class="input-group-text d-none d-sm-flex">
                            <i class="bi bi-telephone"></i>
                        </span>
                        <InputText @bind-Value="Phone" 
                                class="form-control rounded d-sm-none" 
                                placeholder="07X-XXX XX XX" />
                        <InputText @bind-Value="Phone" 
                                class="form-control d-none d-sm-flex" 
                                placeholder="07X-XXX XX XX" />
                    </div>
                    <small class="text-muted d-block mt-2">
                        <i class="bi bi-info-circle me-1"></i>Registrerat mobilnummer krävs
                    </small>
                </div>


            </div>
        </section>

        @* Typ av företag *@
        <section class="mb-4">
            <label class="form-label fw-semibold mb-3">
                <i class="bi bi-briefcase me-2"></i>Typ av företag
            </label>
            <div class="row g-3">
                <InputRadioGroup @bind-Value="CompanyTypeUF">
                    <div class="row-6 col-md-6 col-lg-6 col-xl-6">
                        <div class="form-check-card">
                            <InputRadio 
                                id="typeUF" 
                                class="form-check-input" 
                                checked="@CompanyTypeUFCheck"
                                Value="true" 
                            />
                            <label class="form-check-label w-100 p-3 text-center" for="typeUF">
                                <i class="bi bi-mortarboard-fill d-block fs-3 mb-2 text-primary"></i>
                                <strong>UF-företag</strong>
                            </label>
                        </div>
                    </div>
                    <div class="row-6 col-md-6 col-lg-6 col-xl-6">
                        <div class="form-check-card">
                            <InputRadio 
                                id="typeOther" 
                                class="form-check-input" 
                                checked="@CompanyTypeUFCheck"
                                Value="false" 
                            />
                            <label class="form-check-label w-100 p-3 text-center" for="typeOther">
                                <i class="bi bi-building-fill d-block fs-3 mb-2 text-primary"></i>
                                <strong>Annat</strong>
                            </label>
                        </div>
                    </div>
                </InputRadioGroup>
            </div>
        </section>

        @* Assisterad *@
        <section class="mb-4">
            <div class="card border">
                <div class="card-body p-3">
                    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-sm-between text-center text-sm-start mx-2 mx-sm-4">
                        <div>
                            <label class="form-check-label fw-semibold" for="assistedCheck">
                                <i class="bi bi-people-fill me-2 text-primary"></i>Assisterad setup
                            </label>
                            <small class="text-muted d-block mt-1 ">
                                Vi hjälper dig att komma igång med din butik
                            </small>
                        </div>
                        <div class="form-check form-switch">
                            <CheckboxInput @bind-value="Assisted" 
                                        class="form-check-input" 
                                        id="assistedCheck" 
                                        Label="" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Submit Button -->
        <section class="d-grid">
            <Button Color="ButtonColor.Success" 
                    Size="ButtonSize.Large"
                    @onclick="MakeOrder" 
                    Disabled="!IsFormDataValid"
                    class="btn-submit">
                <i class="bi bi-check-circle-fill me-2"></i>Beställ nu
            </Button>
        </section>
    </div>

    <style>
        .order-form {
            margin: 0 auto;
        }
        
        .input-group-text {
            font-weight: 500;
        }
        
        .form-control:focus,
        .form-check-input:focus {
            border-color: var(--bs-primary);
        }
        
        /* Radio Card Styles */
        .form-check-card {
            position: relative;
        }
        
        .form-check-card .form-check-input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
        }
        
        .form-check-card .form-check-label {
            border: 2px solid var(--bs-border-color);
            border-radius: 0.5rem;
            cursor: pointer;
            transition: all 0.3s ease;
            background-color: var(--bs-body-bg);
        }
        
        .form-check-card .form-check-label:hover {
            border-color: var(--bs-primary);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }
        
        .form-check-card .form-check-input:checked + .form-check-label {
            border-color: var(--bs-primary);
            background-color: var(--bs-primary-bg-subtle);
            box-shadow: 0 0 0 0.2rem var(--bs-primary-border-subtle);
        }
        
        .form-check-card .form-check-input:checked + .form-check-label i {
            color: var(--bs-primary) !important;
        }
        
        /* Switch Styling */
        .form-check-switch .form-check-input {
            width: 3rem;
            height: 1.5rem;
            cursor: pointer;
        }
        
        /* Button Styling */
        .btn-submit {
            font-weight: 600;
            padding: 0.75rem 2rem;
            transition: all 0.3s ease;
        }
        
        .btn-submit:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        }
        
        .btn-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        
        /* Card Hover Effects */
        .card {
            transition: all 0.3s ease;
        }
        
        /* Input Group Styling */
        .input-group-lg .input-group-text {
            font-size: 1rem;
        }
    </style>
}
