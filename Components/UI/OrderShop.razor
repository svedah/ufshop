@using System.Drawing
@using Microsoft.AspNetCore.Identity
@using ufshop.Data.Models
@using ufshop.Helpers
@using ufshop.Shared
@using ufshop.Services
@namespace ufshop.Components.UI
@rendermode InteractiveServer
@* @inject ufshop.Services.BeService BeService *@


@code {

    public readonly BeService beService;
    public readonly OrderShopService Service;

    //BEGIN Form bindings
    string Prefix { get; set; } = string.Empty;
    string Company { get; set; } = string.Empty;
    string Email { get; set; } = string.Empty;
    string Phone { get; set; } = string.Empty;
    @* string CompanyType { get; set; } = string.Empty; *@
    bool CompanyTypeUF { get; set; } = true;
    string CompanyTypeUFCheck
    {
        get
        {
            return CompanyTypeUF ? "checked" : string.Empty;
        }
    }
    bool Assisted { get; set; } = false;
    private bool IsFormDataValid { get { return Service.IsFormDataValid(Prefix, Company, Email, Phone, AgreementCheck); } }
    private bool AgreementCheck { get; set; }
    //END Form bindings

    private bool IsPrefixValid { get { return Service.IsValidPrefix(Prefix); } }

    private string PrefixCSS
    {
        get
        {
            string output = "margin:0;padding:0;text-align:right;";
            if (Prefix.Length > 0)
            {
                if (!IsPrefixValid)
                {
                    output += "border-color: var(--bs-danger);";
                }
                else
                {
                    output += "border-color: var(--bs-success);";
                }
            }

            return output;
        }
    }

    private Guid OrderId { get; set; } = Guid.Empty;
    public string ShortOrderId
    { 
        get
        {
            if (OrderId.Equals(Guid.Empty))
            {
                return string.Empty;
            }
            return OrderId.ToString().Split('-')[0].ToUpper();
        }
    }

    private string SwishButton
    {
        get
        {
            string output = string.Empty;
            output += "<a class=\"btn btn-primary btn-lg w-100 fw-bold d-flex justify-content-center align-items-center\" ";
            output += "target=\"_blank\" ";
            output += "href=\"" + SwishUrl + "\" ";
            output += ">";
            output += "<i class=\"bi bi-phone-fill me-2\"></i>";
            output += "Swisha från denna enheten";
            output += "</a>";
            return output;
        }
    }

    private string SwishQRImage
    {
        get
        {
            return QrImageHelper.MakeEmbeddedImage(SwishUrl);
        }
    }

    private string SwishUrl
    {
        get
        {
            string output = "#";
            if (!OrderId.Equals(Guid.Empty))
            {
                ShopService ss = new ShopService(beService);
                Shop shop;
                if (ss.GetShop(beService.DomainPrefix, out shop))
                {
                    PaymentService ps = new PaymentService(beService);
                    string phoneNumber = ps.GetShopSwishNumber();
                    int amount = Assisted ? Constants.ASSISTEDPRICE : Constants.NONASSISTEDPRICE;
                    string message = Constants.DOMAINNAME + ":" + ShortOrderId;
                    output = ps.BuildSwishRedirectUrl(phoneNumber, amount, message);
                }
            }
            return output;
        }
    }

    public OrderShop(BeService srv)
    {
        beService = srv;
        Service = new OrderShopService(beService);

        OrderId = Guid.Empty;
    }

    private void MakeOrder()
    {
        if (IsFormDataValid)
        {
            Guid orderId = Service.MakeOrder(Prefix, Company, Email, Phone, CompanyTypeUF, Assisted, AgreementCheck);
            if (!orderId.Equals(Guid.Empty))
            {
                OrderId = orderId;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {

    }

}

@* Lara: Kommentera bort dessa två knappar när du designat klart *@
<button @onclick="() => {OrderId = Guid.Empty;}">Formulär</button>
<button @onclick="() => {OrderId = Guid.NewGuid();}">Beställd</button>

@if (ShortOrderId.Length > 0)
{
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12">
                <div class="d-grid text-center mb-4">
                    <Icon Name="IconName.CheckCircleFill"
                        Class="text-success mb-3"
                        Size="IconSize.x1" />

                    <h3 Class="fw-semibold mb-1">
                        Tack för er beställning!
                    </h3>

                    <p class="text-muted small mb-0">
                        Er beställning är mottagen
                    </p>
                </div>

                <div class="text-center my-4">
                    <p class="text-muted small mb-2">Ert ordernummer</p>
                    <Badge Color="BadgeColor.Primary"
                        VisuallyHiddenText="Ordernummer"
                        Class="fs-6 px-3 py-2 rounded-pill">
                        @ShortOrderId
                    </Badge>
                </div>

                <div class="row g-4 align-items-start">


                    <div class="col-12 col-md-6 order-md-2">
                        <Alert Color="AlertColor.Info" Class="">
                            <Icon Name="IconName.InfoCircleFill" Class="me-2" />
                            <span class="fw-semibold">Vad händer nu?</span>

                            <ul class="mt-2 mb-0 ps-3 small">
                                @if(Assisted)
                                {
                                    <li class="mb-1">
                                        En betalning på 
                                        <strong>@Constants.ASSISTEDPRICE kr</strong>
                                        ska ske.
                                    </li>
                                }
                                else
                                {
                                    <li class="mb-1">
                                        En betalning på 
                                        <strong>@Constants.NONASSISTEDPRICE kr</strong>
                                        ska ske.
                                    </li>
                                }
                                <li class="mb-1">
                                    Om beställningen godkänns och betalning för tjänsten skett, 
                                    får ni ett
                                    <strong>avtalskontrakt via e-post</strong>.
                                    Detta avtalskontrakt innehåller 
                                    <strong>inloggningsuppgifter till er UF-shop</strong>.
                                </li>
                            </ul>
                        </Alert>
                    </div>

                    <div class="col-12 col-md-6 order-md-1">
                        <div class="card shadow-sm">
                            <div class="card-header text-white text-center">
                                <h5 class="mb-0 fw-bold">
                                    <i class="bi bi-qr-code me-2"></i>Betala med Swish
                                </h5>
                            </div>

                            <div class="card-body text-center">
                                <div class="mb-4">
                                    <Image Src="@SwishQRImage" 
                                        Alt="Scanna med din mobilkamera eller Swish-appen för att betala din order" 
                                        class="img-fluid shadow rounded"
                                        style="max-width: 280px; width: 100%;" />
                                </div>

                                <div class="mb-4">
                                    @((MarkupString)SwishButton)
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}
else
{

    <div class="order-form">

        @* Shop namn och länk *@
        <section class="mb-4">
            <label class="form-label fw-semibold">
                <i class="bi bi-globe me-2"></i>Namn UF-shop
            </label>

            <div class="input-group input-group-lg">
                <span class="input-group-text border-end-0 d-none d-sm-flex">https://</span>
                
                <input @bind="Prefix"
                    type="text"
                    pattern="[a-z]{16}"
                    class="form-control border-end-0 text-center rounded-start d-sm-none"
                    placeholder="uf-namn"
                    style="@PrefixCSS"
                />
                <input @bind="Prefix"
                    type="text"
                    pattern="[a-z]{16}"
                    class="form-control border-start-0 border-end-0 text-center d-none d-sm-flex"
                    placeholder="uf-namn"
                    style="@PrefixCSS"
                />          
                <span class="input-group-text border-start-0">.ufshop.nu</span>
            </div>

            <small class="text-muted d-block mt-2">
                <i class="bi bi-info-circle me-1"></i>Endast små bokstäver, inga mellanslag
            </small>
        </section>


        @* Företags namn *@
        <section class="mb-4">
            <label class="form-label fw-semibold">
                <i class="bi bi-building me-2"></i>Företagsnamn
            </label>
            <InputText @bind-Value="Company" 
                        class="form-control form-control-lg" 
                        placeholder="Ditt företagsnamn"/>
        </section>
        
        @* Kontakt information *@
        <section class="card border mb-4">
            <div class="card-body p-4">
                <h6 class="fw-semibold mb-3 text-muted">
                    <i class="bi bi-person-lines-fill me-2"></i>KONTAKTINFORMATION
                </h6>

                <!-- Email -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">E-post adress</label>
                    <div class="input-group">
                        <span class="input-group-text d-none d-sm-flex">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <InputText @bind-Value="Email" 
                                type="email" 
                                class="form-control rounded d-sm-none" 
                                placeholder="din@email.se" />

                        <InputText @bind-Value="Email" 
                                type="email" 
                                class="form-control d-none d-sm-flex" 
                                placeholder="din@email.se" />
                    </div>
                    <small class="text-muted d-block mt-2">
                        <i class="bi bi-info-circle me-1"></i>Giltig E-post krävs
                    </small>
                </div>

                <!-- Phone -->
                <div class="mb-0">
                    <label class="form-label fw-semibold">Mobilnummer</label>
                    <div class="input-group">
                        <span class="input-group-text d-none d-sm-flex">
                            <i class="bi bi-telephone"></i>
                        </span>
                        <InputText @bind-Value="Phone" 
                                class="form-control rounded d-sm-none" 
                                placeholder="07X-XXX XX XX" />
                        <InputText @bind-Value="Phone" 
                                class="form-control d-none d-sm-flex" 
                                placeholder="07X-XXX XX XX" />
                    </div>
                    <small class="text-muted d-block mt-2">
                        <i class="bi bi-info-circle me-1"></i>Registrerat mobilnummer krävs
                    </small>
                </div>


            </div>
        </section>

        @* Typ av företag *@
        <section class="mb-4">
            <label class="form-label fw-semibold mb-3">
                <i class="bi bi-briefcase me-2"></i>Typ av företag
            </label>
            <div class="row g-3">
                <InputRadioGroup @bind-Value="CompanyTypeUF">
                    <div class="row-6 col-md-6 col-lg-6 col-xl-6">
                        <div class="form-check-card">
                            <InputRadio 
                                id="typeUF" 
                                class="form-check-input" 
                                checked="@CompanyTypeUFCheck"
                                Value="true" 
                            />
                            <label class="form-check-label w-100 p-3 text-center" for="typeUF">
                                <i class="bi bi-mortarboard-fill d-block fs-3 mb-2 text-primary"></i>
                                <strong>UF-företag</strong>
                            </label>
                        </div>
                    </div>
                    <div class="row-6 col-md-6 col-lg-6 col-xl-6">
                        <div class="form-check-card">
                            <InputRadio 
                                id="typeOther" 
                                class="form-check-input" 
                                checked="@CompanyTypeUFCheck"
                                Value="false" 
                            />
                            <label class="form-check-label w-100 p-3 text-center" for="typeOther">
                                <i class="bi bi-building-fill d-block fs-3 mb-2 text-primary"></i>
                                <strong>Annat</strong>
                            </label>
                        </div>
                    </div>
                </InputRadioGroup>
            </div>
        </section>

        @* Assisterad *@
        <section class="mb-4">
            <div class="card border">
                <div class="card-body p-3">
                    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-sm-between text-center text-sm-start mx-2 mx-sm-4">
                        <div>
                            <label class="form-check-label fw-semibold" for="assistedCheck">
                                <i class="bi bi-people-fill me-2 text-primary"></i>Assisterad setup
                            </label>
                            <small class="text-muted d-block mt-1 ">
                                Vi hjälper dig att komma igång med din butik
                            </small>
                        </div>
                        <div class="form-check form-switch">
                            <CheckboxInput @bind-value="Assisted" 
                                        class="form-check-input" 
                                        id="assistedCheck" 
                                        Label="" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Agreement BEGIN -->
        <section class="mb-4">
            <Accordion>
                <AccordionItem Title="Läs och acceptera vårt avtal">
                    <Content>
                        <div class="agreement-content p-3" style="max-height: 400px; overflow-y: auto;">

                            <h4 class="text-primary mb-3">Avtal om Leverans av UF Shop</h4>

                            <div class="mb-4">
                                <h6 class="fw-bold text-secondary">Avtalets omfattning</h6>
                                <p class="text-muted small">
                                    Leverantören åtar sig att utveckla och leverera en hemsida ("Tjänsten") enligt den offert eller specifikation som Parterna kommit överens om. Tjänsten omfattar endast tekniskt underhåll och driftsättning, om inget annat avtalas skriftligen.
                                </p>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold text-secondary">Kundens ansvar för innehåll</h6>
                                <p class="text-muted small">
                                    Kunden är ensam ansvarig för allt innehåll som publiceras, lagras eller tillgängliggörs via hemsidan, inklusive men inte begränsat till texter, bilder, grafik, media samt produkter eller tjänster som säljs. Kunden garanterar att innehållet inte bryter mot lag eller gör intrång i tredje parts rättigheter.
                                </p>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold text-secondary">Ansvarsfriskrivning</h6>
                                <p class="text-muted small">
                                    Leverantören ansvarar inte för kundens användning av hemsidan, juridiska konsekvenser av innehållet eller skador som uppstår till följd av kundens hantering av hemsidan. Kunden håller Leverantören skadeslös för alla krav som riktas mot Leverantören.
                                </p>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold text-secondary">Förbud mot missbruk av Tjänsten</h6>
                                <p class="text-muted small">
                                    Kunden får inte använda hemsidan för olagliga aktiviteter, spridning av skadlig kod eller handlingar som skadar Leverantörens rykte eller system. Leverantören har rätt att stänga av hemsidan omedelbart vid missbruk. Leverantören förbehåller sig rätten att utan förvarning ta bort innehåll som är olagligt eller kan anses stötande, för politisk aktivism, hat, hot eller hets.
                                </p>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold text-secondary">Drift och support</h6>
                                <p class="text-muted small">
                                    Om kund önskar ytterligare utveckling av tjänsten skall detta regleras i ett separat avtal. Utan sådant avtal ansvarar Leverantören inte för uppdateringar, säkerhet, backup eller driftstörningar hos tredje part.
                                </p>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold text-secondary">Leverans och godkännande</h6>
                                <p class="text-muted small">
                                    Tjänsten anses levererad när hemsidan görs tillgänglig för Kunden. Kunden ska inom 10 dagar meddela eventuella fel, annars anses Tjänsten godkänd.
                                </p>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold text-secondary">Betalningsvillkor</h6>
                                <p class="text-muted small">
                                    Betalning ska ske enligt offert eller faktura. Försenad betalning kan medföra dröjsmålsränta enligt räntelagen.
                                </p>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold text-secondary">Äganderätt och licenser</h6>
                                <p class="text-muted small">
                                    Kunden får full nyttjanderätt till hemsidan vid full betalning. Leverantören behåller äganderätten till tjänsten och material som inte specifikt ingår i beställningen.
                                </p>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold text-secondary">Avtalstid och uppsägning</h6>
                                <p class="text-muted small">
                                    Avtalet gäller från underskriftsdatum tills Tjänsten är levererad. Ansvarsbegränsningarna gäller även efter avtalstidens slut. Tjänsten anses uppsagd när endera part i avtalet meddelar att avtalet inte längre gäller.
                                </p>
                            </div>

                            <div class="mb-0">
                                <h6 class="fw-bold text-secondary">Tvist</h6>
                                <p class="text-muted small mb-0">
                                    Tvist avgörs i första hand genom förhandling. I andra hand avgörs tvist i svensk domstol med Leverantörens hemort som forum.
                                </p>
                            </div>

                        </div>
                        <div class="border-top mt-3 pt-3">
                            <div class="form-check">
                                <CheckboxInput Label="Jag har läst och accepterar detta avtal" 
                                            @bind-Value="AgreementCheck" 
                                            class="form-check-input" 
                                            id="agreementCheck" />
                            </div>
                        </div>
                    </Content>
                </AccordionItem>
            </Accordion>
        </section>
        <!-- Agreement END -->

        <!-- Submit Button -->
        <section class="d-grid">
            <Button Color="ButtonColor.Success" 
                    Size="ButtonSize.Large"
                    @onclick="MakeOrder" 
                    Disabled="!IsFormDataValid"
                    class="btn-submit">
                <i class="bi bi-check-circle-fill me-2"></i>Beställ nu
            </Button>
        </section>
    </div>

    <style>
        .order-form {
            margin: 0 auto;
        }
        
        .input-group-text {
            font-weight: 500;
        }
        
        .form-control:focus,
        .form-check-input:focus {
            border-color: var(--bs-primary);
        }
        
        /* Radio Card Styles */
        .form-check-card {
            position: relative;
        }
        
        .form-check-card .form-check-input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
        }
        
        .form-check-card .form-check-label {
            border: 2px solid var(--bs-border-color);
            border-radius: 0.5rem;
            cursor: pointer;
            transition: all 0.3s ease;
            background-color: var(--bs-body-bg);
        }
        
        .form-check-card .form-check-label:hover {
            border-color: var(--bs-primary);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }
        
        .form-check-card .form-check-input:checked + .form-check-label {
            border-color: var(--bs-primary);
            background-color: var(--bs-primary-bg-subtle);
            box-shadow: 0 0 0 0.2rem var(--bs-primary-border-subtle);
        }
        
        .form-check-card .form-check-input:checked + .form-check-label i {
            color: var(--bs-primary) !important;
        }
        
        /* Switch Styling */
        .form-check-switch .form-check-input {
            width: 3rem;
            height: 1.5rem;
            cursor: pointer;
        }
        
        /* Button Styling */
        .btn-submit {
            font-weight: 600;
            padding: 0.75rem 2rem;
            transition: all 0.3s ease;
        }
        
        .btn-submit:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
        }
        
        .btn-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        
        /* Card Hover Effects */
        .card {
            transition: all 0.3s ease;
        }
        
        /* Input Group Styling */
        .input-group-lg .input-group-text {
            font-size: 1rem;
        }
    </style>
}
